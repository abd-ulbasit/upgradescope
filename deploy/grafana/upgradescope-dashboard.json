{
  "uid": "upgradescope",
  "title": "upgradescope",
  "description": "Kubernetes upgrade readiness from the upgradescope agent (this cluster) and server (the fleet). Metrics reference: docs/observability.md.",
  "tags": ["kubernetes", "upgrades", "upgradescope"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Agent: this cluster",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Readiness score by target",
      "description": "0-100 per target from the last successful tick.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "max by (target) (upgradescope_readiness_score)", "legendFormat": "{{target}}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "green", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "textMode": "value_and_name" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Verdict by target",
      "description": "ready: no blockers and every required check assessed. blocked: at least one blocker. unknown: no blockers found, but a required check was not assessed.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "max by (target, verdict) (upgradescope_readiness_verdict == 1)", "legendFormat": "{{target}}: {{verdict}}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*: ready" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*: blocked" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*: unknown" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "textMode": "name" }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Findings by target and severity",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "sum by (target, severity) (upgradescope_findings)", "legendFormat": "{{target}} {{severity}}", "instant": true }
      ],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal", "displayMode": "basic" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Collector capabilities",
      "description": "Capabilities not available leave parts of the report not assessed; the ClusterReadiness status.notAssessed says why.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "min by (capability) (upgradescope_capability_available)", "legendFormat": "{{capability}}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "not assessed", "color": "orange" }, "1": { "text": "available", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "textMode": "value_and_name" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Since last successful tick",
      "description": "Above about two intervals the agent is not ticking and its readiness probe fails.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 7 },
      "targets": [
        { "refId": "A", "expr": "time() - max(upgradescope_agent_last_success_timestamp_seconds)", "legendFormat": "age", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value" }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tick duration (p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 7 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(upgradescope_agent_tick_duration_seconds_bucket[1h])))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Failed ticks and pushes",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 7 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(upgradescope_agent_tick_errors_total[1h]))", "legendFormat": "failed ticks / 1h" },
        { "refId": "B", "expr": "sum(increase(upgradescope_agent_push_errors_total[1h]))", "legendFormat": "failed pushes / 1h" }
      ],
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Server: fleet",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "panels": []
    },
    {
      "id": 10,
      "type": "table",
      "title": "Clusters",
      "description": "Each cluster's current evaluation per target (default next minor plus the server's --targets).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "max by (cluster, target) (upgradescope_cluster_score)", "format": "table", "instant": true },
        { "refId": "B", "expr": "max by (cluster, target) (upgradescope_cluster_blockers)", "format": "table", "instant": true },
        { "refId": "C", "expr": "max by (cluster, target, verdict) (upgradescope_cluster_verdict == 1)", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value #C": true }, "renameByName": { "Value #A": "score", "Value #B": "blockers" } } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "verdict" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [ { "type": "value", "options": { "ready": { "color": "green" }, "blocked": { "color": "red" }, "unknown": { "color": "orange" } } } ] }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Since last push",
      "description": "Agents push on every inventory change and at least hourly; longer means the agent is down or cannot reach the server.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "max by (cluster) (upgradescope_cluster_last_push_age_seconds)", "legendFormat": "{{cluster}}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3900 },
              { "color": "red", "value": 7200 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal", "displayMode": "basic" }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Snapshot pushes by result",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (rate(upgradescope_ingest_total[15m]))", "legendFormat": "{{result}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "API latency by route (p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(upgradescope_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "API errors (5xx) by route",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (rate(upgradescope_http_requests_total{code=~\"5..\"}[5m]))", "legendFormat": "{{route}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
