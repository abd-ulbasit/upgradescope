{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "upgradescope chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "duration": {
      "description": "Go duration of at least one minute, e.g. 10m, 1h, 1m30s, 90s, 1.5h. One of its parts must be a minute or more on its own (1m, 60s, 0.017h and up), so a sum such as 30s30s is refused.",
      "type": "string",
      "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(h|m|s|ms|us|µs|μs|ns))*((0*[1-9][0-9]*(\\.[0-9]*)?|0*\\.(0[2-9]|01[7-9]|[1-9])[0-9]*)h|0*[1-9][0-9]*(\\.[0-9]*)?m|0*([6-9][0-9]|[1-9][0-9]{2,})(\\.[0-9]*)?s)(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(h|m|s|ms|us|µs|μs|ns))*$"
    },
    "targets": {
      "description": "Kubernetes minor versions, e.g. [\"1.37\", \"1.38\"].",
      "type": "array",
      "items": { "type": "string", "pattern": "^v?1\\.[0-9]+(\\.[0-9]+)?$" }
    },
    "crTargets": {
      "description": "Kubernetes minor versions written to the ClusterReadiness spec.targets, e.g. [\"1.37\", \"1.38\"]. MAJOR.MINOR only, as the CRD requires.",
      "type": "array",
      "items": { "type": "string", "pattern": "^1\\.[0-9]+$" }
    },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "list": { "type": "array" },
    "object": { "type": "object" },
    "secretName": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$", "maxLength": 253 }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "helmSecrets": { "type": "boolean" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "$ref": "#/definitions/duration" },
        "crName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$", "maxLength": 253 },
        "teamLabel": { "type": "string", "minLength": 1 },
        "clusterName": { "type": "string" },
        "manageCRD": { "type": "boolean" },
        "targets": {
          "description": "At most 8, as the CRD's spec.targets: the agent refuses a longer --targets at start.",
          "allOf": [{ "$ref": "#/definitions/crTargets" }],
          "maxItems": 8
        },
        "serverUrl": { "type": "string", "pattern": "^(https?://.+)?$" },
        "serverToken": { "type": "string" },
        "existingSecret": { "$ref": "#/definitions/secretName" },
        "serverCA": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configMap": { "$ref": "#/definitions/secretName" },
            "secret": { "$ref": "#/definitions/secretName" },
            "key": { "type": "string", "pattern": "^[-._a-zA-Z0-9]*$", "maxLength": 253 }
          }
        },
        "healthPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "logFormat": { "type": "string", "enum": ["text", "json"] },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "extraRegistry": {
          "description": "Extra add-on registry entries: file name <id>.yaml to the entry's YAML.",
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.yaml$" },
          "additionalProperties": { "type": "string" }
        },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "extraEnv": { "$ref": "#/definitions/list" },
        "extraVolumes": { "$ref": "#/definitions/list" },
        "extraVolumeMounts": { "$ref": "#/definitions/list" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "$ref": "#/definitions/list" },
        "affinity": { "$ref": "#/definitions/object" },
        "priorityClassName": { "type": "string" },
        "podSecurityContext": { "$ref": "#/definitions/object" },
        "securityContext": { "$ref": "#/definitions/object" },
        "resources": { "$ref": "#/definitions/object" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingestToken": { "type": "string" },
        "sharedIngestToken": { "type": "boolean" },
        "readToken": { "type": "string" },
        "existingSecret": { "$ref": "#/definitions/secretName" },
        "readTokenFromSecret": { "type": "boolean" },
        "adminToken": { "type": "string" },
        "adminTokenFromSecret": { "type": "boolean" },
        "slackWebhook": { "type": "string", "pattern": "^(https?://.+)?$" },
        "webhook": { "type": "string", "pattern": "^(https?://.+)?$" },
        "webhookSecret": { "type": "string" },
        "targets": {
          "description": "Extra targets serve evaluates on every snapshot: at most 4 entries (serve --targets takes 4 distinct minors; this counts entries, so 1.39 and v1.39 are two), since each adds a report of up to --max-snapshot-bytes to every push and re-evaluation and the server's memory limit is sized for that many.",
          "allOf": [{ "$ref": "#/definitions/targets" }],
          "maxItems": 4
        },
        "retention": {
          "description": "Whole days (90d), a Go duration (2160h) of at least a day, or 0 to keep everything (`--set server.retention=0` passes the number 0); serve validates the value.",
          "anyOf": [
            { "type": "string", "pattern": "^(0|[0-9]+d|([0-9]+(\\.[0-9]*)?(h|m|s))+)$" },
            { "type": "integer", "enum": [0] }
          ]
        },
        "staleAfter": { "$ref": "#/definitions/duration" },
        "replicas": { "type": "integer", "minimum": 1 },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "$ref": "#/definitions/secretName" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "teamMap": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern", "team"],
            "properties": {
              "pattern": { "type": "string", "minLength": 1 },
              "team": { "type": "string", "minLength": 1 }
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "$ref": "#/definitions/stringMap" },
            "host": { "type": "string" },
            "path": { "type": "string", "pattern": "^/" },
            "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] },
            "allowAnonymousRead": { "type": "boolean" },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "secretName": { "$ref": "#/definitions/secretName" }
              }
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": { "$ref": "#/definitions/secretName" },
            "caKey": { "type": "string" },
            "certManager": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issuerRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "kind": { "type": "string" },
                    "group": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string", "minLength": 1 },
            "storageClass": { "type": "string" }
          }
        },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "extraEnv": { "$ref": "#/definitions/list" },
        "extraVolumes": { "$ref": "#/definitions/list" },
        "extraVolumeMounts": { "$ref": "#/definitions/list" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "$ref": "#/definitions/list" },
        "affinity": { "$ref": "#/definitions/object" },
        "priorityClassName": { "type": "string" },
        "podSecurityContext": { "$ref": "#/definitions/object" },
        "securityContext": { "$ref": "#/definitions/object" },
        "resources": { "$ref": "#/definitions/object" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "serverIngressFrom": { "$ref": "#/definitions/list" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "description": "Prometheus duration, e.g. 30s, 1m.", "type": "string", "pattern": "^([0-9]+(ms|s|m|h))+$" },
            "labels": { "$ref": "#/definitions/stringMap" }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "$ref": "#/definitions/stringMap" },
            "clusterStaleAfterSeconds": { "type": "integer", "minimum": 60 }
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "$ref": "#/definitions/stringMap" },
            "annotations": { "$ref": "#/definitions/stringMap" }
          }
        }
      }
    },
    "global": { "type": "object" }
  }
}
